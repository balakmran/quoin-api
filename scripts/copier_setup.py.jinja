    index_path.write_text(content, encoding="utf-8")
    print("Wrote minimal docs/index.md")


def clean_zensical() -> None:
    """Trim the docs site config: nav, home JS, and personal social links."""
    zensical_path = BASE_DIR / "zensical.toml"
    if not zensical_path.exists():
        return
    content = zensical_path.read_text(encoding="utf-8")

    # Surgically drop only the nav entries for the pages removed above,
    # leaving the rest of the (source-controlled) nav untouched so it can't
    # drift from zensical.toml as guides/sections are added over time.
    # [{] / [}] match a literal brace defensively: should this pattern ever be
    # edited so two braces sit adjacent, a bare "{{"/"}}" would form a Jinja
    # token in this .jinja template. As written there is no adjacency, so the
    # class form is precautionary.
    removed_nav_pages = (
        "docs.md",
        "architecture/decision-log.md",
        "project/roadmap.md",
    )
    for page in removed_nav_pages:
        content = re.sub(
            r'^[ \t]*[{][ \t]*"[^"]+"[ \t]*=[ \t]*"'
            + re.escape(page)
            + r'"[ \t]*[}],\n',
            "",
            content,
            flags=re.MULTILINE,
        )

    # Drop the home page's own stylesheet and script. Both style markup
    # that clean_index() has already replaced, and the template config
    # excludes the files themselves.
    content, removed = re.subn(
        r'    "stylesheets/home\.css",\n',
        "",
        content,
    )
    # A miss would point the docs build at a stylesheet the generated
    # project does not have.
    if not removed:
        raise RuntimeError(
            "zensical.toml has no home.css entry matching the pattern in "
            "clean_zensical(); the pattern needs updating."
        )
    content = re.sub(
        r'extra_javascript = \[\n    "javascripts/home\.js",\n\]\n',
        "",
        content,
    )

    # Drop personal (X / LinkedIn) social links; keep the GitHub one.
    for brand in ("x-twitter", "linkedin"):
        content = re.sub(
            r'\n\n\[\[project\.extra\.social\]\]\n'
            rf'icon = "fontawesome/brands/{brand}"\nlink = "[^"]*"',
            "",
            content,
        )

    # Fail loudly rather than silently leaking the author's personal handles
    # if the social-link block above is ever reformatted past these patterns.
    leaked = [d for d in ("x.com", "x-twitter", "linkedin") if d in content]
    if leaked:
        raise RuntimeError(
            f"zensical.toml still references personal socials {leaked}; "
            "the social-link removal in clean_zensical() needs updating."
        )

    zensical_path.write_text(content, encoding="utf-8")
    print("Trimmed zensical.toml")


def strip_removed_links() -> None:
    """Remove cross-references to docs pages that were dropped.

    The roadmap is template-only: copier.yml excludes it and
    prune_sync_docs() stops it being regenerated. Any link to it would
    dangle in a generated project, so they are rewritten here rather
    than left for the first docs build to warn about.
    """
    overview_path = BASE_DIR / "docs" / "architecture" / "overview.md"
    if overview_path.exists():
        content = overview_path.read_text(encoding="utf-8")
        content = re.sub(
            r"- \[Decision Log\]\(decision-log\.md\)[^\n]*\n",
            "",
            content,
        )
        overview_path.write_text(content, encoding="utf-8")
        print("Stripped dropped-page links from architecture/overview.md")

    docs_dir = BASE_DIR / "docs"
    # (page, pattern, replacement) — a whole list item goes, but a link
    # inside a sentence is unwrapped so the prose still reads.
    roadmap_links = (
        (
            docs_dir / "project.md",
            r"- \[Roadmap\]\(project/roadmap\.md\)[^\n]*\n",
            "",
        ),
        (
            docs_dir / "guides" / "pagination.md",
            r"\[backlog\]\(\.\./project/roadmap\.md#backlog\)",
            "backlog",
        ),
        (
            docs_dir / "guides" / "dependency-scanning.md",
            r"\(see the\n\[Roadmap backlog\]\(\.\./project/roadmap\.md\)\)",
            "(a deliberate non-goal)",
        ),
    )
    for path, pattern, replacement in roadmap_links:
        if not path.exists():
            continue
        content = path.read_text(encoding="utf-8")
        updated = re.sub(pattern, replacement, content)
        if updated != content:
            path.write_text(updated, encoding="utf-8")
            print(f"Stripped roadmap link from {path.relative_to(BASE_DIR)}")


def strip_screenshots() -> None:
    """Remove embedded screenshots from the generated docs.

    Every image under ``docs/assets/images/`` pictures this template's
    own UI, down to the name in the header, so the template config
    excludes them. The embeds have to go with them: the general
    substitution pass has already rewritten their paths to the adopter's
    slug, which points at a file that was never there.
    """
    # The blank line after the embed goes too, or the strip leaves a
    # double gap the docs build renders as extra whitespace.
    embed = re.compile(
        r"^!\[[^\]]*\]\([^)]*assets/images/[^)]*\)\n\n?", re.MULTILINE
    )
    for path in BASE_DIR.rglob("*.md"):
        if any(part in IGNORE_PATHS for part in path.parts):
            continue
        content = path.read_text(encoding="utf-8")
        updated = embed.sub("", content)
        if updated != content:
            path.write_text(updated, encoding="utf-8")
            print(f"Stripped screenshot from {path.relative_to(BASE_DIR)}")


def brand_logo() -> None:
    """Set the docs logo's letter to the project's initial.

    The logo is a single glyph, and the substitution pass never reaches
    it -- ``.svg`` is in IGNORE_EXTENSIONS. Left alone it puts this
    template's initial in the header of every page an adopter builds.
    """
    logo_path = BASE_DIR / "docs" / "assets" / "logo.svg"
    if not logo_path.exists():
        return
    initial = next(
        (char for char in PROJECT_NAME if char.isalnum()), "A"
    ).upper()
    content = logo_path.read_text(encoding="utf-8")
    content, replaced = re.subn(r">[^<>]</text>", f">{initial}</text>", content)
    if not replaced:
        raise RuntimeError(
            "docs/assets/logo.svg has no single-glyph <text> element "
            "matching the pattern in brand_logo(); it needs updating."
        )
    logo_path.write_text(content, encoding="utf-8")
    print(f"Set the docs logo to {initial}")


# Marker pairs that fence off template-only prose, by comment syntax.
TEMPLATE_ONLY_MARKERS = (
    ("<!-- template-only -->", "<!-- /template-only -->"),
    ("# template-only", "# /template-only"),
    ("%% template-only", "%% /template-only"),
)


def strip_template_only() -> None:
    """Remove blocks that only apply to the template repository.

    A handful of files document maintaining the template itself --
    verifying `copier update` between two tags, the scan that keeps this
    name out of generated projects. The scripts and tests behind them
    are not shipped, so the prose and the `just` recipe that call them
    would dangle. Fencing a block in the marker pair opts it out.
    """
    for root, dirs, files in os.walk(BASE_DIR):
        dirs[:] = [d for d in dirs if d not in IGNORE_PATHS]
        for file_name in files:
            path = Path(root) / file_name
            if path.suffix in IGNORE_EXTENSIONS:
                continue
            # This script carries the markers as literals.
            if file_name == "copier_setup.py":
                continue
            try:
                content = path.read_text(encoding="utf-8")
            except UnicodeDecodeError:
                continue
            original = content
            for opening, closing in TEMPLATE_ONLY_MARKERS:
                if opening not in content:
                    continue
                content = re.sub(
                    rf"^[ \t]*{re.escape(opening)}[^\n]*\n"
                    rf".*?^[ \t]*{re.escape(closing)}[^\n]*\n",
                    "",
                    content,
                    flags=re.DOTALL | re.MULTILINE,
                )
                # An unclosed marker would leave the block in place --
                # silently shipping what it was written to withhold.
                residual = re.compile(
                    rf"^[ \t]*{re.escape(opening)}", re.MULTILINE
                )
                if residual.search(content):
                    raise RuntimeError(
                        f"{path.relative_to(BASE_DIR)} has a "
                        f"'{opening}' marker with no matching "
                        f"'{closing}'."
                    )
            if content != original:
                content = re.sub(r"\n{3,}", "\n\n", content)
                path.write_text(content, encoding="utf-8")
                print(f"Stripped template-only block from "
                      f"{path.relative_to(BASE_DIR)}")


def rewrite_security_policy() -> None:
    """Replace the security policy's header with the adopter's own.

    The shipped policy opens by declaring the repository a Copier
    template and pointing reports at the template's maintainer. Renamed
    but otherwise intact, it would tell a generated project's users that
    *their* project is a template and invite them to report bugs in code
    the template author no longer owns. Everything from `## Reporting a
    Vulnerability` down is already correct once substituted -- the
    advisory link and address are theirs -- so only the header is
    rewritten, in both the root file and the docs copy of it.
    """
    # The project name goes on a line of its own: a long one would push
    # the prose past the 80 columns the rest of the docs keep to.
    header = f"""# Security Policy

This policy covers **{PROJECT_NAME}**.

It ships with the project as a starting point: review the supported
versions and the response targets below and edit them to what you can
actually commit to. Nothing here is a promise made on your behalf.

---

## Supported Versions

| Version | Supported |
| :------ | :-------- |
| `main` (latest, unreleased) | Yes |
| Latest tagged release | Yes |
| Older tags | No |

---

"""
    targets = (
        BASE_DIR / "SECURITY.md",
        BASE_DIR / "docs" / "project" / "security-policy.md",
    )
    marker = "## Reporting a Vulnerability"
    for path in targets:
        if not path.exists():
            continue
        content = path.read_text(encoding="utf-8")
        index = content.find(marker)
        # Failing loudly beats shipping a policy addressed to the
        # template's maintainer under the adopter's project name.
        if index == -1:
            raise RuntimeError(
                f"{path.relative_to(BASE_DIR)} has no '{marker}' heading; "
                "the anchor in rewrite_security_policy() needs updating."
            )
        path.write_text(header + content[index:], encoding="utf-8")
        print(f"Rewrote the header of {path.relative_to(BASE_DIR)}")


def prune_sync_docs() -> None:
    """Drop the ROADMAP entry from the docs sync script."""
    sync_path = BASE_DIR / "scripts" / "sync_docs.py"
    if not sync_path.exists():
        return
    content = sync_path.read_text(encoding="utf-8")
    # The path-adjust flag is matched generically: it flipped to True once
    # the roadmap gained docs/guides/ links, and pinning the literal would
    # make this a silent no-op the next time it changes.
    content, removed = re.subn(
        r'        \(root / "ROADMAP\.md", docs_project / "roadmap\.md", '
        r"(?:True|False)\),\n",
        "",
        content,
    )

    # Fail loudly rather than shipping a generated project whose sync
    # script still points at the ROADMAP.md that copier.yml excludes.
    if not removed:
        raise RuntimeError(
            "scripts/sync_docs.py has no ROADMAP entry matching the "
            "pattern in prune_sync_docs(); the pattern needs updating."
        )

    # The module docstring lists what the script copies, so drop the
    # roadmap from it too. Unlike the entry above this is cosmetic, so a
    # miss here must not abort generation the way the guard above does.
    content = re.sub(
        r"(?<=CHANGELOG\.md, )ROADMAP\.md,\s+", "", content, count=1
    )

    sync_path.write_text(content, encoding="utf-8")
    print("Pruned ROADMAP from scripts/sync_docs.py")


def _pinned_ruff() -> str | None:
    """Read the ruff version pinned by the generated `pyproject.toml`.

    Returns:
        The pinned version, or None if no pin is present.
    """
    pyproject = BASE_DIR / "pyproject.toml"
    if not pyproject.is_file():
        return None
    match = re.search(r'"ruff==([^"]+)"', pyproject.read_text(encoding="utf-8"))
    return match.group(1) if match else None


def format_sources() -> None:
    """Re-run the formatter over the generated tree.

    Substituting identifiers changes both line length and import sort
    order, so source that was formatted in the template can land here
    unformatted: a long line splits, a shorter name lets one join, and a
    renamed import moves in the sort. No amount of hand-wrapping in the
    template fixes this -- the correct output genuinely differs per
    project name -- so format once here instead, and a fresh clone's
    first `just check` has nothing to rewrite.

    Best effort: a failure leaves a tidy-but-unformatted project, which
    `just check` fixes on its first run.
    """
    if shutil.which("uvx") is None:
        print("Warning: uvx not found; skipping format. Run `just check`.")
        return

    # Must be the version the project pins, not whatever uvx resolves.
    # Formatting with one ruff and checking with another reintroduces
    # exactly the drift this function exists to remove.
    pin = _pinned_ruff()
    if pin is None:
        print("Warning: no ruff pin found in pyproject.toml; skipping.")
        print("Run `just check` in the new project to format it.")
        return
    ruff = ["uvx", "--from", f"ruff=={pin}", "ruff"]

    # `ruff check --fix` exits non-zero merely because unfixable
    # violations remain -- the project's own `just check` reports those
    # far better than this script can. Only the format pass must succeed.
    for args, must_succeed in (
        (["check", "--fix", "."], False),
        (["format", "."], True),
    ):
        try:
            result = subprocess.run(
                [*ruff, *args],
                cwd=BASE_DIR,
                capture_output=True,
                text=True,
                timeout=180,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"Warning: `ruff {args[0]}` failed ({exc}).")
            print("Run `just check` in the new project to format it.")
            return
        if must_succeed and result.returncode != 0:
            # Never fall through to the success message: an offline
            # generation fails here, and silently claiming success
            # leaves a dirty tree with no explanation for it.
            print(f"Warning: `ruff {args[0]}` failed:")
            print(result.stderr.strip() or result.stdout.strip())
            print("Run `just check` in the new project to format it.")
            return

    print(f"Formatted generated sources (ruff {pin})")


if __name__ == "__main__":
    print(f"Running post-generation setup for {PROJECT_NAME}...")
    run_replacements()
    write_clean_changelog()
    reset_readme()
    clean_index()
    clean_zensical()
    strip_removed_links()
    strip_screenshots()
    rewrite_security_policy()
    strip_template_only()
    brand_logo()
    prune_sync_docs()
    format_sources()

    # Self-destruct copier files from the generated project
    try:
        os.remove(__file__)
        copier_yml = BASE_DIR / "copier.yml"
        if copier_yml.exists():
            os.remove(copier_yml)
    except Exception as e:
        print(f"Warning: Could not remove setup files: {e}")

    print("Setup complete! 🎉")
