# Local development settings. Every value below is the code default unless
# marked "dev". The Configuration guide documents each one.

# =============================================================================
# Application
# =============================================================================
QUOIN_ENV=development                    # development | test | production
QUOIN_LOG_LEVEL=INFO
QUOIN_ACCESS_LOG_ENABLED=True
QUOIN_OTEL_ENABLED=True

# =============================================================================
# Request handling
# =============================================================================
QUOIN_REQUEST_ID_HEADER=X-Request-ID
QUOIN_REQUEST_TIMEOUT_SECONDS=30.0       # <=0 disables
QUOIN_SHUTDOWN_DRAIN_TIMEOUT=30.0        # <=0 skips the drain
QUOIN_MAX_REQUEST_BODY_BYTES=1048576     # 1 MiB; <=0 disables

# =============================================================================
# Hosts and CORS
# =============================================================================
# Production refuses to boot on this default host list.
QUOIN_ALLOWED_HOSTS='["localhost","127.0.0.1","test","*.orb.local"]'
QUOIN_BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'
QUOIN_BACKEND_CORS_ALLOW_METHODS='["GET","POST","PUT","PATCH","DELETE","OPTIONS"]'
QUOIN_BACKEND_CORS_ALLOW_HEADERS='["Authorization","Content-Type"]'
QUOIN_BACKEND_CORS_EXPOSE_HEADERS='["Deprecation","Sunset","Link"]'
QUOIN_BACKEND_CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# Security headers
# =============================================================================
QUOIN_SECURITY_HEADERS_ENABLED=True
QUOIN_SECURITY_HSTS_MAX_AGE=31536000     # 0 disables HSTS
QUOIN_SECURITY_HSTS_INCLUDE_SUBDOMAINS=True
QUOIN_SECURITY_HSTS_PRELOAD=False
QUOIN_SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
QUOIN_SECURITY_PERMISSIONS_POLICY="geolocation=(), camera=(), microphone=()"
# Default policy, then the per-path policies for /, /docs, and /redoc.
QUOIN_SECURITY_CSP="default-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'"
QUOIN_SECURITY_CSP_HOME="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://cdn.simpleicons.org; script-src 'self'; frame-ancestors 'none'; base-uri 'self'"
QUOIN_SECURITY_CSP_DOCS="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.simpleicons.org https://fastapi.tiangolo.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; frame-ancestors 'none'; base-uri 'self'"
QUOIN_SECURITY_CSP_REDOC="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.simpleicons.org https://fastapi.tiangolo.com https://cdn.redoc.ly; script-src 'self' https://cdn.jsdelivr.net; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'"

# =============================================================================
# Database
# =============================================================================
QUOIN_POSTGRES_DRIVER=postgresql+asyncpg
QUOIN_POSTGRES_HOST=localhost
QUOIN_POSTGRES_PORT=5432
QUOIN_POSTGRES_USER=postgres
QUOIN_POSTGRES_PASSWORD=postgres
QUOIN_POSTGRES_DB=app_db

QUOIN_DB_POOL_SIZE=20
QUOIN_DB_MAX_OVERFLOW=10
QUOIN_DB_POOL_TIMEOUT=30.0
QUOIN_DB_POOL_RECYCLE=1800               # seconds; -1 disables
QUOIN_DB_POOL_PRE_PING=True

# =============================================================================
# OAuth 2.0 / OIDC
# =============================================================================
# dev: the local mock (just oauth). Production requires all three, with
# an https:// JWKS URI.
QUOIN_OAUTH_JWKS_URI=http://localhost:8080/default/jwks
QUOIN_OAUTH_ISSUER=http://localhost:8080/default
QUOIN_OAUTH_AUDIENCE=default
QUOIN_OAUTH_ROLES_CLAIM=aud              # dev: the mock puts roles in aud
QUOIN_OAUTH_SUPERUSER_ROLE=api.superuser
QUOIN_OAUTH_SUPERUSER_ENABLED=True       # dev: off by default
QUOIN_OAUTH_JWKS_MIN_REFRESH_SECONDS=30.0
QUOIN_OAUTH_JWKS_TTL_SECONDS=3600

# =============================================================================
# Outbound HTTP client
# =============================================================================
QUOIN_HTTP_TIMEOUT_SECONDS=10.0
QUOIN_HTTP_RETRY_ATTEMPTS=3              # 1 = no retry
